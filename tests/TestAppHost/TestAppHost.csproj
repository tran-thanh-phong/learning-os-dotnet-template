<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CleanArchitecture.TestAppHost</RootNamespace>
    <AssemblyName>CleanArchitecture.TestAppHost</AssemblyName>
    <!-- false: restore the dashboard/DCP from nuget.org instead of letting the build run `dnx aspire.cli setup`. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (UsePostgreSQL)-->
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <!--#endif-->
    <!--#if (UseSqlServer)-->
    <PackageReference Include="Aspire.Hosting.Azure.Sql" />
    <!--#endif-->
    <!--#if (UseSqlite)-->
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.SQLite" />
    <!--#endif-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
